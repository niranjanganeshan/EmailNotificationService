{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "appuser",
    "Password": "apppassword123!",
    "VirtualHost": "/notifications",
    "ExchangeName": "notifications.topic",
    "QueueName": "email.send.queue",
    "RoutingKey": "email.send",
    "DeadLetterExchangeName": "notifications.dlx",
    "DeadLetterQueueName": "email.send.dlq",
    "DeadLetterRoutingKey": "email.send.dead",
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3
  },
  "EmailSimulator": {
    "FailureRatePercent": 30
  }
}
