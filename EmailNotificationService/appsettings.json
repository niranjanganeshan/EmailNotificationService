{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "appuser",
    "Password": "apppassword123!",
    "VirtualHost": "/notifications",
    "ExchangeName": "notifications.topic",
    "QueueName": "email.send.queue",
    "RoutingKey": "email.send",
    "DeadLetterExchangeName": "notifications.dlx",
    "DeadLetterQueueName": "email.send.dlq",
    "DeadLetterRoutingKey": "email.send.dead",
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3
  }
}
